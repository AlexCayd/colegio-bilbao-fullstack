# ══════════════════════════════════════════════════════════════════════════════
# includes/.env.example — plantilla de configuración
#
# Copiar a `includes/.env` y rellenar. El archivo real NUNCA se commitea
# (está en .gitignore): contiene credenciales de la base de datos y del SMTP.
#
# Lo carga includes/app.php con vlucas/phpdotenv en modo safeLoad(): si el
# archivo no existe la aplicación NO revienta, arranca con los valores por
# defecto de includes/database.php (localhost, usuario y contraseña vacíos) y
# falla más tarde al conectar. Por eso conviene verificarlo con /diagnostico.php
# tras cada despliegue.
#
# Todas las variables se leen como $_ENV['NOMBRE'].
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos (obligatorio) ───────────────────────────────────────────────
# Las lee includes/database.php. Motor MySQL 8 / MariaDB 10.6+, conexión MySQLi
# con charset utf8mb4. DB_PORT es opcional: si falta se usa 3306.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=colegiobilbao
DB_USER=
DB_PASS=

# ── URL pública del sitio (obligatorio si se usa el correo) ───────────────────
# Base con la que classes/Email.php construye los enlaces de confirmación de
# cuenta y de restablecimiento de contraseña. SIN barra final.
#   Desarrollo: http://localhost:3000
#   Producción: https://www.colegiobilbao.edu.mx
HOST=http://localhost:3000

# ── SMTP (obligatorio solo para el registro público de familias) ──────────────
# Los usa classes/Email.php (PHPMailer, SMTP autenticado). Afectan únicamente al
# flujo público /registro · /olvide · /reestablecer.
#
# ⚠️ El panel de colaboradores (/login) NO envía correo: las contraseñas las
#    asigna un administrador desde Usuarios. Si el sitio no ofrece registro
#    público, estas cuatro variables pueden quedar vacías sin romper nada.
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
