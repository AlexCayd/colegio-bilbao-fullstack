# Dependencias
node_modules/
vendor
# Paquete de vendor/ para subir a producción por hPanel. Se regenera cuando haga
# falta; no tiene sentido versionar un artefacto de 5 MB.
vendor.zip

# ⚠️ Secretos — NUNCA deben versionarse
# includes/.env e includes/.env_deploy estuvieron trackeados: además de estas reglas
# hay que sacarlos del índice y ROTAR las credenciales, porque siguen en el historial.
# Procedimiento en docs/05-despliegue.md § Secretos versionados.
includes/.env
includes/.env_deploy
includes/.env.*
!includes/.env.example

# Documentación generada por phpDocumentor (artefacto, se regenera)
docs/api/
.phpdoc-cache/

# Archivos de sistema
.DS_Store
Thumbs.db

# Diagnóstico temporal del PDF de horarios. Se sube a producción por FTP, se lee
# y se borra: no debe quedar versionado ni en el servidor.
check-pdf.php

# Horarios originales del colegio (PDFs con datos del claustro)
horarios_grupos/

# Subidas de usuarios: las genera la aplicación en tiempo de ejecución
public/build/assets/blog/
public/build/assets/noticias/
public/build/assets/usuarios/
# Carpeta heredada de los justificantes. Ya no se escribe en ella —el shim de
# index.php la deniega con 404— pero puede quedar contenido antiguo en disco.
public/build/assets/suplencias/

# Justificantes: partes médicos, fuera de public/ para que no los sirva el shim.
# La carpeta se conserva en git con su propio .gitignore; el contenido nunca.
storage/justificantes/*
!storage/justificantes/.gitkeep
# Excepción: los del SEED. Son documentos ficticios en texto plano a los que apunta
# development.sql; sin ellos en disco, `rutaJustificante()` devuelve null y toda la
# cola sale como "Archivo no encontrado" — el flujo de revisión no se puede probar.
# Nunca añadir aquí un archivo real: esta carpeta es la única que no vigila el shim.
!storage/justificantes/ejemplo-*.txt

# Caché de fuentes de Dompdf (.ufm/.json). La genera sola al primer PDF a partir de
# los TTF de src/fonts/, que esos sí se versionan.
storage/fuentes-pdf/*
!storage/fuentes-pdf/.gitkeep

# Diccionario del claustro SUBIDO desde el panel. El versionado es el de
# `diccionario/`, que es el suelo al que se vuelve; aquí solo cae lo que alguien
# carga en su instalación, y en producción no tiene por qué coincidir con el repo.
storage/diccionario/*
!storage/diccionario/.gitkeep
